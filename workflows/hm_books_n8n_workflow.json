      "id": "webhook-fonnte",
      "name": "Webhook — Fonnte Incoming",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "jsCode": "// Normalize payload dari Fonnte\nconst body = $input.first().json;\n\nconst phone = body.sender || body.phone;\nconst message = body.message || body.text;\nconst timestamp = body.timestamp || Math.floor(Date.now() / 1000);\n\nif (!phone || !message) {\n  throw new Error('Invalid Fonnte payload');\n}\n\n// Deteksi tipe pesan\nconst isMedia = body.file || body.url || body.type === 'image' || body.type === 'document';\n\nreturn [{\n  json: {\n    phone: phone.replace(/[^0-9]/g, ''),\n    message: message,\n    timestamp: timestamp,\n    is_media: isMedia,\n    media_url: body.file || body.url || null,\n    raw: body\n  }\n}];\n"
      },
      "id": "normalize-payload",
      "name": "Normalize Fonnte Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "operation": "select",
        "schema": "public",
        "table": "leads",
        "where": {
          "conditions": [
            {
              "column": "phone",
              "operator": "eq",
              "value": "={{ $json.phone }}"
            }
          ]
        },
        "limit": 1
      },
      "id": "get-lead-supabase",
      "name": "Get Lead from Supabase",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [680, 300],
      "credentials": {
        "supabaseApi": {
          "id": "supabase-creds",
          "name": "Supabase HM Books"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const leadData = $('Get Lead from Supabase').first()?.json;\nconst incoming = $('Normalize Fonnte Payload').first().json;\n\nconst isNew = !leadData || !leadData.id;\n\nreturn [{\n  json: {\n    is_new_lead: isNew,\n    lead: isNew ? null : leadData,\n    incoming: incoming\n  }\n}];\n"
      },
      "id": "check-lead-exists",
