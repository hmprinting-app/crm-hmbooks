    {
      "parameters": {
        "jsCode": "// Merge lead info dan history untuk dikirim ke Claude\nconst incoming = $('Normalize Fonnte Payload').first().json;\nconst isNew = $('Check Lead Exists').first().json.is_new_lead;\n\nlet lead, history;\n\nif (isNew) {\n  lead = $('Create Lead in Supabase').first().json;\n  history = [];\n} else {\n  lead = $('Get Lead from Supabase').first().json;\n  const rawHistory = $('Get Chat History').all();\n  history = rawHistory.map(item => ({\n    role: item.json.role,\n    content: item.json.content\n  }));\n}\n\n// Deteksi eskalasi dari pesan baru\nconst msg = incoming.message.toLowerCase();\nconst escalateKeywords = [\n  'telepon', 'video call', 'komplain', 'kecewa', 'tipu',\n  'kembalikan uang', 'refund', 'tidak puas', 'marah'\n];\nconst shouldEscalate = escalateKeywords.some(k => msg.includes(k));\n\n// Build context payload untuk Claude\nconst contextPayload = {\n  lead_id: lead.id,\n  phone: incoming.phone,\n  nama: lead.nama || null,\n  stage: lead.stage || 'NEW_LEAD',\n  history: history,\n  pesan_baru: incoming.message,\n  is_media: incoming.is_media,\n  media_url: incoming.media_url,\n  should_escalate: shouldEscalate\n};\n\nreturn [{ json: contextPayload }];\n"
      },
      "id": "build-claude-context",
      "name": "Build Claude Context",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1580, 300]
    },
    {
      "parameters": {
        "conditions": {
          "conditions": [
            {
              "leftValue": "={{ $json.should_escalate }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ]
        }
      },
      "id": "if-escalate",
      "name": "Should Escalate?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1800, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {"name": "x-api-key", "value": "={{ $credentials.httpHeaderAuth.value }}"},
            {"name": "anthropic-version", "value": "2023-06-01"},
            {"name": "content-type", "value": "application/json"}
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": []
        },
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"claude-sonnet-4-20250514\",\n  \"max_tokens\": 500,\n  \"system\": {{ JSON.stringify($('Get System Prompt').first().json.prompt) }},\n  \"messages\": [\n    ...{{ JSON.stringify($json.history) }},\n    {\n      \"role\": \"user\",\n      \"content\": {{ JSON.stringify('CONTEXT:\\n' + JSON.stringify({lead_id: $json.lead_id, phone: $json.phone, nama: $json.nama, stage: $json.stage}) + '\\n\\nPESAN BARU:\\n' + $json.pesan_baru) }}\n    }\n  ]\n}"
      },
      "id": "call-claude-api",
      "name": "Call Claude API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2020, 160],
      "credentials": {
        "httpHeaderAuth": {
          "id": "claude-api-key",
          "name": "Claude API Key"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Parse Claude response + extract metadata JSON\nconst claudeResp = $input.first().json;\nconst rawText = claudeResp.content?.[0]?.text || '';\n\n// Extract JSON metadata jika ada (di bagian akhir respons)\nlet metadata = {};\nlet replyText = rawText;\n\nconst jsonMatch = rawText.match(/```json\\s*([\\s\\S]*?)```/);\nif (jsonMatch) {\n  try {\n    metadata = JSON.parse(jsonMatch[1]);\n    replyText = rawText.replace(/```json[\\s\\S]*?```/, '').trim();\n  } catch(e) {\n    // JSON parse gagal, pakai raw text saja\n  }\n}\n\nconst context = $('Build Claude Context').first().json;\n\nreturn [{\n  json: {\n    lead_id: context.lead_id,\n    phone: context.phone,\n    reply: replyText,\n    metadata: metadata,\n    new_stage: metadata.stage || context.stage,\n    escalate: metadata.escalate || false,\n    offer_audit: metadata.offer_audit || false,\n    follow_up_trigger: metadata.follow_up_trigger || null,\n    input_tokens: claudeResp.usage?.input_tokens || 0,\n    output_tokens: claudeResp.usage?.output_tokens || 0\n  }\n}];\n"
      },
      "id": "parse-claude-response",
      "name": "Parse Claude Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2240, 160]
