      "id": "get-chat-history",
      "name": "Get Chat History",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [1340, 440],
      "credentials": {
        "supabaseApi": {
          "id": "supabase-creds",
          "name": "Supabase HM Books"
        }
