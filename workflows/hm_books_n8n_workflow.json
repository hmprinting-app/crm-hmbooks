      "parameters": {
        "jsCode": "// Kirim notifikasi eskalasi ke owner via Fonnte\nconst ctx = $('Build Claude Context').first().json;\nconst OWNER_PHONE = '628xxxxxxxxxx'; // Ganti dengan nomor owner\n\nconst msg = `🚨 ESKALASI DIPERLUKAN\\n\\nLead: ${ctx.phone}\\nNama: ${ctx.nama || 'Belum diketahui'}\\nStage: ${ctx.stage}\\n\\nPesan terakhir:\\n${ctx.pesan_baru}\\n\\nSilakan hubungi langsung.`;\n\nreturn [{ json: { phone: OWNER_PHONE, message: msg } }];\n"
      },
